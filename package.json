{
  "name": "pure-cbor",
  "version": "1.1.0",
  "description": "Fast, functional CBOR for JavaScript and TypeScript: the full RFC 8949 data model, streaming, COSE-ready, zero dependencies",
  "author": "Dave Tonge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidgtonge/pure-cbor.git"
  },
  "homepage": "https://davidgtonge.github.io/pure-cbor/",
  "bugs": "https://github.com/davidgtonge/pure-cbor/issues",
  "keywords": [
    "cbor",
    "rfc8949",
    "rfc8742",
    "rfc8746",
    "cose",
    "webauthn",
    "cwt",
    "mdoc",
    "serialization",
    "binary",
    "streaming",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "tsc -p tsconfig.json --noEmit && oxlint -D correctness -D suspicious src",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "bench": "npm run build && node bench/bench.mjs",
    "bench:compare": "npm run build && node bench/compare.mjs",
    "bench:isolated": "npm run build && node bench/isolated.mjs",
    "bench:stream": "npm run build && node bench/stream.mjs",
    "bench:json": "npm run build && node bench/json.mjs",
    "bench:cose": "npm run build && node bench/cose.mjs",
    "prepublishOnly": "npm run lint && npm test"
  },
  "devDependencies": {
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
